# TEMAZO - Variables de entorno opcionales
#
# Copiá este archivo como .env y ajustá los valores que necesites.
# Ninguna de estas variables es obligatoria: TEMAZO funciona con los
# valores por defecto.

# Tamaño máximo de subida de audio en megabytes (por defecto: 50)
TEMAZO_MAX_UPLOAD_MB=50

# Tamaño máximo de subida de video en megabytes (por defecto: 70)
TEMAZO_MAX_VIDEO_MB=70

# Directorio donde se guardan los archivos de audio.
# Si se omite, se usa <proyecto>/uploads
TEMAZO_UPLOAD_DIR=uploads

# Clave secreta para firmar la cookie de sesión.
# IMPORTANTE: si no se define, se genera una aleatoria al iniciar la
# aplicación, lo que invalida las sesiones al reiniciar.
# Recomendado: git-bash -c 'openssl rand -hex 32'
TEMAZO_SESSION_SECRET=un-codigo-secreto-muy-largo

# ID del track que se reproduce como banda sonora de fondo.
# Si se omite, no hay música de fondo. Ejemplo: 5 (Brown Bear)
# TEMAZO_BACKGROUND_TRACK_ID=5
